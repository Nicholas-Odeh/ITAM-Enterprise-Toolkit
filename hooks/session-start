#!/usr/bin/env bash
# SessionStart hook for the ITAM toolkit.
# Injects the using-itam-plugin router skill as additional context so the
# routing table and core operating rules are in context from the first turn.
# Uses the plugin host context output format.
# Invoked as: bash "${CLAUDE_PLUGIN_ROOT}/hooks/session-start"

set -euo pipefail

# Prefer CLAUDE_PLUGIN_ROOT; fall back to this script's parent folder.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT}"
else
  PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

SKILL_FILE="${PLUGIN_ROOT}/skills/using-itam-plugin/SKILL.md"

# If the router is missing, exit quietly: the plugin still works without it.
if [ ! -r "${SKILL_FILE}" ]; then
  exit 0
fi

# Drop the YAML frontmatter (first --- ... --- block); keep the body.
body="$(awk 'NR==1 && $0=="---" {fm=1; next} fm && $0=="---" {fm=0; next} !fm' "${SKILL_FILE}")"

# Escape a string for embedding in a JSON string literal.
# Order matters: backslashes first. Other control characters are removed.
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\r'/}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\n'/\\n}"
  s="$(printf '%s' "$s" | tr -d '\000-\010\013\014\016-\037')"
  printf '%s' "$s"
}

header="The ITAM plugin is installed. Below is its router skill, itam:using-itam-plugin. Load other ITAM skills with the Skill tool when the routing table matches the request."
context="<itam-plugin>
${header}

${body}
</itam-plugin>"

escaped="$(escape_for_json "${context}")"

# Use printf for portable JSON output.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "${escaped}"

exit 0
